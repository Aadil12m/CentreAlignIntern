# Required for real runs and evals
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-opus-5-5)
# TASKPILOT_MODEL=claude-sonnet-5-5
# Optional: extra secrets the agent can type via {{secret:name}} placeholders
# TASKPILOT_SECRET_ERP_PASSWORD=acme-ap-2026
# Optional: use a specific Chromium binary
# TASKPILOT_CHROMIUM=/path/to/chrome
